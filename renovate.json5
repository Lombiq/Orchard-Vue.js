{
    '$schema': 'https://docs.renovatebot.com/renovate-schema.json',
    'extends': ['github>Lombiq/renovate-config:default-orchard-core-submodule.json5'],
    packageRules: [
        {
            groupName: 'Vue',
            matchPackageNames: [
                'vue*',
            ],
        },
        {
            groupName: 'Rollup',
            matchPackageNames: [
                '/.*rollup.*/',
            ],
        },
        {
            groupName: 'All packages',
            matchUpdateTypes: ['*'],
        },
    ],
}
