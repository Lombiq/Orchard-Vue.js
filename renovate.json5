{
    '$schema': 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'github>Lombiq/Open-Source-Orchard-Core-Extensions:renovate-osoce-orchard-core-submodule.json5',
    ],
    packageRules: [
        {
            groupName: 'Vue',
            matchPackageNames: [
                'vue*',
            ],
        },
        {
            groupName: 'Rollup',
            matchPackageNames: [
                '/.*rollup.*/',
            ],
        },
        {
            groupName: 'All packages',
            matchUpdateTypes: ['*'],
        },
    ],
}
