{
    '$schema': 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'github>Lombiq/Open-Source-Orchard-Core-Extensions:renovate-osoce-orchard-core-submodule.json5',
    ],
    packageRules: [
        {
            groupName: 'Vue',
            matchPackageNames: [
                'vue*',
            ],
            // Keeping minor and patch updates together with all other such non-breaking updates to prevent having too
            // many pull requests.
            matchUpdateTypes: ['major'],
        },
        {
            groupName: 'Rollup',
            matchPackageNames: [
                '/.*rollup.*/',
            ],
            // Keeping minor and patch updates together with all other such non-breaking updates to prevent having too
            // many pull requests.
            matchUpdateTypes: ['major'],
        },
    ],
}
