{
    '$schema': 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'github>Lombiq/Open-Source-Orchard-Core-Extensions:renovate-osoce-orchard-core-submodule.json5',
    ],
    packageRules: [
        {
            // As the Lombiq.VueJs project is deprecated, its dependencies should not be updated besides security fixes.
            groupName: 'Legacy Lombiq.VueJs',
            matchFileNames: ['Lombiq.VueJs/**', 'Lombiq.VueJs.Samples/**'],
            matchManagers: ['npm'],
            matchUpdateTypes: ['major', 'minor'],
            enabled: false,
        },
        {
            groupName: 'Vue',
            matchPackageNames: [
                'vue*',
            ],
            // Keeping minor and patch updates together with all other such non-breaking updates to prevent having too
            // many pull requests.
            matchUpdateTypes: ['major'],
        },
        {
            groupName: 'Rollup',
            matchPackageNames: [
                '/.*rollup.*/',
            ],
            // Keeping minor and patch updates together with all other such non-breaking updates to prevent having too
            // many pull requests.
            matchUpdateTypes: ['major'],
        },
    ],
}
